---
import { parts, chapterHref } from '../lib/report.mjs';
import type { getChapters } from '../lib/content';
interface Props {
  chapters: Awaited<ReturnType<typeof getChapters>>;
  active?: number;
}
const { chapters, active = 0 } = Astro.props;
---

<nav class="chapter-nav" aria-label="Report contents">
  <a href="/" class="back-link">
    ← Report overview
  </a>
  <p class="eyebrow">In this report</p>
  {parts.map((part, i) => (
    <section>
      <h2>
        <span>{String(i + 1).padStart(2, '0')}</span> {part}
      </h2>
      <ol>
        {chapters
          .filter((c) => Number(c.data.part) === i + 1)
          .map((c) => (
            <li>
              <a
                href={chapterHref(c)}
                aria-current={Number(c.data.number) === Number(active) ? 'page' : undefined}
              >
                <span>{String(c.data.number).padStart(2, '0')}</span>
                {c.data.title}
              </a>
            </li>
          ))}
      </ol>
    </section>
  ))}
</nav>
