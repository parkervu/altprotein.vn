---
import { label, type Lang } from '../lib/i18n';
import { SITE, PAGE_BY_ID, href, chapterNumber, appendixLetter, type NavItem } from '../lib/site';
interface Props {
  lang: Lang;
  current?: string;
  /** Top-level groups to show (defaults to all except Home and Data). */
  only?: string[];
}
const { lang, current, only } = Astro.props;
const groups = SITE.nav.filter((g) => g.children && (!only || only.includes(g.label!)));
const containsCurrent = (item: NavItem): boolean =>
  item.page === current || Boolean(item.children?.some(containsCurrent));
const num = (id: string) => {
  const n = chapterNumber(id);
  if (n !== null) return String(n);
  return appendixLetter(id) ?? '';
};
const newTitle = lang === 'vi' ? 'Mới trong ấn bản 1.1' : 'New in edition 1.1';
const newText = lang === 'vi' ? 'Mới' : 'New';
---

<nav class="tree" aria-label={lang === 'vi' ? 'Mục lục báo cáo' : 'Report contents'}>
  <ul>
    {
      groups.map((group) => (
        <li class="group">
          <details open={!current || containsCurrent(group) || group.label === 'Summary'}>
            <summary>{label(group.label!, lang)}</summary>
            <ul>
              {group.children!.map((item) =>
                item.children ? (
                  <li class="subgroup">
                    <details open={containsCurrent(item) || (!current && group.label === 'Report')}>
                      <summary>
                        {label(item.label!, lang)}
                        {item.new_in_edition && (
                          <span class="new-pill" title={newTitle}>
                            {newText}
                          </span>
                        )}
                      </summary>
                      <ul>
                        {item.children.map((leaf) => {
                          const page = PAGE_BY_ID.get(leaf.page!)!;
                          return (
                            <li>
                              <a
                                href={href(page.id, lang)}
                                aria-current={page.id === current ? 'page' : undefined}
                                data-aud={page.audiences.join(' ')}
                                lang={page.lang !== lang ? page.lang : undefined}
                              >
                                <span class="num">{num(page.id)}</span>
                                <span>{page.short_title.replace(/^[A-Z]\. /, '')}</span>
                                <span class="for-you-dot" aria-hidden="true" />
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li>
                    <a
                      href={href(item.page!, lang)}
                      aria-current={item.page === current ? 'page' : undefined}
                      data-aud={PAGE_BY_ID.get(item.page!)!.audiences.join(' ')}
                      lang={PAGE_BY_ID.get(item.page!)!.lang !== lang ? PAGE_BY_ID.get(item.page!)!.lang : undefined}
                    >
                      <span>{PAGE_BY_ID.get(item.page!)!.short_title}</span>
                      <span class="for-you-dot" aria-hidden="true" />
                    </a>
                  </li>
                ),
              )}
            </ul>
          </details>
        </li>
      ))
    }
  </ul>
</nav>
