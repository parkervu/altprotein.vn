---
import NavTree from './NavTree.astro';
import SourcesList from './SourcesList.astro';
import { audienceLabel, t, type Lang } from '../lib/i18n';
import type { RenderResult } from '../lib/markdown';
import datasets from '../generated/datasets.json';
import {
  PAGE_BY_ID,
  SITE,
  href,
  localize,
  neighbours,
  chapterNumber,
  appendixCode,
  ROLE,
  type PageMeta,
} from '../lib/site';

interface Props {
  meta: PageMeta;
  title: string;
  summary?: string | null;
  rendered: RenderResult;
  isPreview?: boolean;
}
const { meta, title, summary, rendered, isPreview } = Astro.props;
const lang: Lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const vi = lang === 'vi';
const contentLang = meta.lang;
const { prev, next } = neighbours(meta.id);
const chapter = chapterNumber(meta.id);
const letter = appendixCode(meta.id);
const sectionCrumb = {
  front: null,
  report: { label: s.report, href: localize('/report', lang) },
  brief: { label: s.forYou, href: localize('/briefs', lang) },
  appendix: { label: s.appendices, href: localize('/appendices', lang) },
}[meta.section];
const eyebrow =
  meta.section === 'report'
    ? `${vi ? 'Chương' : 'Chapter'} ${chapter} · ${vi ? 'Phần' : 'Part'} ${meta.part?.split('.')[0]}`
    : meta.section === 'brief'
      ? vi
        ? 'Bản tóm lược'
        : 'Audience brief'
      : meta.section === 'appendix'
        ? `${vi ? 'Phụ lục' : 'Appendix'} ${letter}`
        : null;
const related = meta.related_pages.map((id) => PAGE_BY_ID.get(id)).filter(Boolean) as PageMeta[];
const dataFiles = meta.related_data
  .map((f) =>
    (datasets as { file: string; slug: string; group: string }[]).find(
      (d) => d.file === f && d.group === 'data',
    ),
  )
  .filter(Boolean) as { file: string; slug: string }[];
// Point readers to the counterpart in their language, where the page's language differs.
const COUNTERPART: Record<string, string> = {
  [ROLE.summaryVi]: ROLE.summary,
  [ROLE.prologueVi]: ROLE.prologue,
  [ROLE.summary]: ROLE.summaryVi,
  [ROLE.prologue]: ROLE.prologueVi,
};
const langNote =
  contentLang !== lang
    ? contentLang === 'vi'
      ? {
          text: 'This page is in Vietnamese.',
          link: href(COUNTERPART[meta.id] ?? ROLE.summary, lang),
          linkText:
            COUNTERPART[meta.id] === ROLE.prologue
              ? 'Read the English prologue'
              : 'Read the English summary',
        }
      : vi
        ? {
            text: 'Nội dung trang này bằng tiếng Anh.',
            link: href(COUNTERPART[meta.id] ?? ROLE.summaryVi, lang),
            linkText:
              COUNTERPART[meta.id] === ROLE.prologueVi
                ? 'Đọc lời mở đầu tiếng Việt'
                : 'Đọc bản tóm tắt tiếng Việt',
          }
        : null
    : null;
const isVision = meta.id === ROLE.vision;
// The four registers are best used as filterable tables.
const REGISTER_VIEWS: Record<string, { en: string; vi: string; href: string }> = {
  [ROLE.openQuestions]: {
    en: 'Filter the open questions',
    vi: 'Lọc các câu hỏi mở',
    href: '/data/open-questions',
  },
  [ROLE.disagreements]: {
    en: 'Filter the disagreements',
    vi: 'Lọc các điểm bất đồng',
    href: '/data/disagreements',
  },
  [ROLE.glossary]: { en: 'Search the glossary', vi: 'Tìm trong bảng thuật ngữ', href: '/glossary' },
  [ROLE.sources]: { en: 'Filter the sources', vi: 'Lọc các nguồn', href: '/data/sources' },
};
const registerView = REGISTER_VIEWS[meta.id];
---

<div class="frame">
  <div class="doc-layout">
    <aside class="doc-side" aria-label={vi ? 'Mục lục' : 'Contents'}>
      <p class="side-title">{vi ? 'Báo cáo' : 'The report'}</p>
      <NavTree lang={lang} current={meta.id} />
    </aside>
    <article class="doc-main" lang={contentLang !== lang ? contentLang : undefined}>
      <ol class="crumbs" lang={lang !== contentLang ? lang : undefined}>
        <li>
          <a href={localize('/', lang)}>{s.home}</a>
        </li>
        {sectionCrumb && (
          <li>
            <a href={sectionCrumb.href}>{sectionCrumb.label}</a>
          </li>
        )}
        {meta.section === 'report' && meta.part && (
          <li>
            <span>{meta.part}</span>
          </li>
        )}
      </ol>
      <header class="page-head">
        {(eyebrow || isVision) && (
          <p class="eyebrow" lang={lang !== contentLang ? lang : undefined}>
            {eyebrow && <span>{eyebrow}</span>}
            {isVision && (
              <span class="fx" data-fx="vision">
                <span>{s.visionNotForecast}</span>
              </span>
            )}
          </p>
        )}
        <h1 set:html={rendered.heading ?? title} />
        {summary && <p class="page-lead">{summary}</p>}
        <div class="page-meta" lang={lang !== contentLang ? lang : undefined}>
          {meta.reading_time_min && <span>{s.minRead(meta.reading_time_min)}</span>}
          {meta.audiences.length > 0 && meta.audiences.length < 6 && (
            <span class="aud-chips" aria-label={vi ? 'Dành cho' : 'Written for'}>
              {meta.audiences.map((a) => (
                <span class="aud-chip" data-key={a}>
                  {audienceLabel(a, lang, SITE.audiences[a])}
                </span>
              ))}
            </span>
          )}
          <a href={href(ROLE.howToRead, lang, 'evidence-tags')}>{s.evidenceLegend}</a>
          <button class="btn-ghost no-print" type="button" data-print>
            {s.print}
          </button>
        </div>
      </header>
      {isPreview && (
        <p class="preview-note" role="status" lang={lang}>
          {vi
            ? 'Bản xem trước của biên tập viên: nội dung chưa xuất bản.'
            : 'Editor preview: unpublished changes.'}{' '}
          <a href={Astro.url.pathname}>{vi ? 'Thoát' : 'Exit preview'}</a>
        </p>
      )}
      {langNote && (
        <p class="lang-note" lang={lang}>
          {langNote.text} <a href={langNote.link}>{langNote.linkText}</a>
        </p>
      )}
      {rendered.toc.filter((h) => h.depth === 2).length > 2 && (
        <details class="mobile-toc">
          <summary lang={lang}>{s.onThisPage}</summary>
          <ol>
            {rendered.toc
              .filter((h) => h.depth === 2)
              .map((h) => (
                <li>
                  <a href={`#${h.id}`}>{h.text}</a>
                </li>
              ))}
          </ol>
        </details>
      )}
      {meta.id === ROLE.method && (
        <aside class="callout callout-note no-print" lang={lang}>
          <p>
            <strong>{s.downloads}.</strong>{' '}
            <a href="/downloads/altprotein-vn-working-papers.zip" download>
              {s.downloadWorking}
            </a>{' '}
            ·{' '}
            <a href="/downloads/altprotein-vn-data.zip" download>
              {s.downloadData}
            </a>
          </p>
        </aside>
      )}
      {registerView && (
        <aside class="callout callout-note no-print" lang={lang}>
          <p>
            <strong>{vi ? 'Dạng bảng.' : 'As a table.'}</strong>{' '}
            <a href={localize(registerView.href, lang)}>{vi ? registerView.vi : registerView.en}</a>
          </p>
        </aside>
      )}
      <div class={`prose${isVision ? ' prose-vision' : ''}`} set:html={rendered.html} />
      <SourcesList ids={rendered.citations} lang={lang} />
      <footer class="page-foot" lang={lang}>
        {related.length > 0 && (
          <section>
            <h2>{s.related}</h2>
            <ul class="related-list">
              {related.map((p) => (
                <li>
                  <a href={href(p.id, lang)} lang={p.lang !== lang ? p.lang : undefined}>
                    <small>
                      {p.section === 'report'
                        ? `${vi ? 'Chương' : 'Chapter'} ${chapterNumber(p.id)}`
                        : p.section === 'appendix'
                          ? `${vi ? 'Phụ lục' : 'Appendix'} ${appendixCode(p.id)}`
                          : p.section === 'brief'
                            ? vi
                              ? 'Bản tóm lược'
                              : 'Brief'
                            : ''}
                    </small>
                    {p.short_title.replace(/^[A-Z]\d*\. /, '')}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        {dataFiles.length > 0 && (
          <section>
            <h2>{s.relatedData}</h2>
            <ul class="data-links">
              {dataFiles.map((d) => (
                <li>
                  <a href={localize(`/data/${d.slug}`, lang)}>{d.file}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <nav class="pager" aria-label={vi ? 'Trang trước và sau' : 'Previous and next'}>
          {prev && (
            <a class="prev" href={href(prev.id, lang)} rel="prev">
              <small>← {s.previous}</small>
              <span lang={prev.lang !== lang ? prev.lang : undefined}>{prev.short_title}</span>
            </a>
          )}
          {next && (
            <a class="next" href={href(next.id, lang)} rel="next">
              <small>{s.next} →</small>
              <span lang={next.lang !== lang ? next.lang : undefined}>{next.short_title}</span>
            </a>
          )}
        </nav>
      </footer>
    </article>
    {rendered.toc.length > 1 && (
      <aside class="doc-toc" aria-labelledby="toc-title" lang={lang}>
        <p class="toc-title" id="toc-title">
          {s.onThisPage}
        </p>
        <ol lang={contentLang}>
          {rendered.toc.map((h) => (
            <li class={`d${h.depth}`}>
              <a href={`#${h.id}`}>{h.text}</a>
            </li>
          ))}
        </ol>
        <div class="toc-tools">
          <a href={href(ROLE.howToRead, lang, 'evidence-tags')}>{s.evidenceLegend}</a>
          {rendered.citations.length > 0 && <a href="#sources-cited">{s.sourcesCited}</a>}
          <button type="button" data-print>
            {s.print}
          </button>
        </div>
      </aside>
    )}
  </div>
</div>
