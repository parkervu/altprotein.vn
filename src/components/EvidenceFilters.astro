<div class="evidence-tools" aria-label="Evidence focus">
  <span class="eyebrow">Evidence lens</span>
  <div class="filter-buttons" role="group" aria-label="Focus evidence by origin">
    {['All evidence', 'VN-direct', 'VN-adjacent', 'general'].map((label, i) => (
      <button
        type="button"
        class="filter"
        data-evidence-filter={i === 0 ? 'all' : label}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {label}
      </button>
    ))}
  </div>
  <p class="filter-status" aria-live="polite">
    All evidence shown. Unlabelled context stays visible.
  </p>
</div>
<script>
  import { installEvidenceFilters } from '../lib/evidence';
  installEvidenceFilters(document);
</script>
