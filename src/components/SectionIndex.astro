---
import { label, t } from '../lib/i18n';
import {
  APPENDIX_GROUPS,
  PAGES,
  PAGE_BY_ID,
  PARTS,
  appendixCode,
  partId,
  chapterNumber,
  href,
  type PageMeta,
} from '../lib/site';

interface Props {
  kind: 'report' | 'brief' | 'appendix';
}
const { kind } = Astro.props;
const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const vi = lang === 'vi';
const pages = PAGES.filter((p) => p.section === kind);
const groups: { id: string; title: string; pages: PageMeta[] }[] =
  kind === 'report'
    ? PARTS.map((part) => ({
        id: partId(part),
        title: label(part, lang),
        pages: pages.filter((p) => p.part === part),
      }))
    : kind === 'appendix'
      ? APPENDIX_GROUPS.map((g) => ({
          id: `group-${g.id}`,
          title: label(g.label, lang),
          pages: g.pages.map((id) => PAGE_BY_ID.get(id)!).filter(Boolean),
        }))
      : [{ id: 'briefs', title: '', pages }];
const heading = { report: s.report, brief: s.briefsHeading, appendix: s.appendicesHeading }[kind];
const intro = {
  report: vi
    ? 'Ba mươi chương trong năm phần: bối cảnh, phía cung, phía cầu, tương lai và những việc nên làm. Nội dung báo cáo bằng tiếng Anh.'
    : 'Thirty chapters in five parts: the context, the supply side, the demand side, the futures to 2050, and what to do.',
  brief: vi
    ? 'Sáu bản tóm lược, mỗi bản cho một nhóm độc giả: điều gì quan trọng với bạn và nên đọc tiếp ở đâu.'
    : 'Six short briefs, one per audience: what matters to you, and where to read next.',
  appendix: vi
    ? 'Bằng chứng chi tiết theo chủ đề: phương pháp và hồ sơ (M), bối cảnh và phía cung (S), phía cầu (D), tương lai (F) và các sổ đăng ký (R).'
    : 'The detailed evidence by theme: method and record (M), context and supply (S), demand (D), futures (F) and registers (R).',
}[kind];
const kicker = (p: PageMeta) =>
  kind === 'report'
    ? `${vi ? 'Chương' : 'Chapter'} ${chapterNumber(p.id)}`
    : kind === 'appendix'
      ? `${vi ? 'Phụ lục' : 'Appendix'} ${appendixCode(p.id)}`
      : vi
        ? 'Bản tóm lược'
        : 'Brief';
---

<div class="frame">
  <header class="index-head">
    <h1>{heading}</h1>
    <p>{intro}</p>
  </header>
  {groups.map((g) => (
    <section class="part-block" id={g.id} aria-labelledby={g.title ? `${g.id}-h` : undefined}>
      {g.title && <h2 id={`${g.id}-h`}>{g.title}</h2>}
      <div class="card-grid">
        {g.pages.map((p) => (
          <a class="card" href={href(p.id, lang)} data-aud={p.audiences.join(' ')}>
            <span class="card-kicker">
              {kicker(p)}
              <span class="for-you">{s.forAudience}</span>
            </span>
            <span class="card-title" lang={vi ? 'en' : undefined}>
              {p.heading.replace(/^(\d+|[A-Z]\d*)\. /, '')}
            </span>
            <span class="card-text" lang={vi ? 'en' : undefined}>
              {p.summary}
            </span>
            <span class="card-meta">{p.reading_time_min && s.minRead(p.reading_time_min)}</span>
          </a>
        ))}
      </div>
    </section>
  ))}
  <div style="height:64px"></div>
</div>
