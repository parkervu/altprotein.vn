---
import '@fontsource-variable/work-sans';
import '../styles/global.css';
import '../generated/charts.css';
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import NavTree from '../components/NavTree.astro';
import { t, type Lang } from '../lib/i18n';
import { SITE, localize } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** EmDash entry shown on this page (enables the editor toolbar and SEO data). */
  content?: { collection: string; id: string; slug?: string };
  noindex?: boolean;
  current?: string;
  /** Top navigation item to mark as current. */
  section?: 'summary' | 'report' | 'briefs' | 'appendices' | 'data' | 'search' | 'about';
  pageClass?: string;
}
const {
  title,
  description = SITE.title,
  content,
  noindex = false,
  current,
  section,
  pageClass,
} = Astro.props;
const lang: Lang = Astro.locals.lang ?? 'en';
const s = t(lang);
Astro.response.headers.set('Cache-Control', 'private, no-store');

// The same page in the other interface language.
const basePath = Astro.locals.basePath ?? Astro.url.pathname;
const enPath = basePath;
const viPath = localize(basePath, 'vi');
const otherHref = (lang === 'vi' ? enPath : viPath) + Astro.url.search;
const canonical = new URL(lang === 'vi' ? viPath : enPath, Astro.site).href;
const fullTitle =
  title === SITE.title ? `${SITE.title} · AltProtein Vietnam` : `${title} · AltProtein Vietnam`;

const page = createPublicPageContext({
  Astro,
  kind: content ? 'content' : 'custom',
  pageType: content ? 'article' : 'website',
  title: fullTitle,
  description,
  canonical,
  content,
  siteName: 'AltProtein Vietnam',
});
const nav = [
  {
    key: 'summary',
    label: s.summary,
    href: localize(lang === 'vi' ? '/tom-tat' : '/summary', lang),
  },
  { key: 'report', label: s.report, href: localize('/report', lang) },
  { key: 'briefs', label: s.forYou, href: localize('/briefs', lang) },
  { key: 'appendices', label: s.appendices, href: localize('/appendices', lang) },
  { key: 'data', label: s.data, href: localize('/data', lang) },
];
const searchAction = localize('/search', lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).href} />
    <link rel="alternate" hreflang="vi" href={new URL(viPath, Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AltProtein Vietnam" />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_GB'} />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1413" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var th = localStorage.getItem('theme');
          if (th === 'light' || th === 'dark') d.setAttribute('data-theme', th);
          var a = localStorage.getItem('audience');
          if (a) d.setAttribute('data-audience', a);
        } catch (e) {}
        d.classList.add('js');
      })();
    </script>
    <EmDashHead page={page} />
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">
      {s.skip}
    </a>
    <EmDashBodyStart page={page} />
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={localize('/', lang)} aria-label={`${s.siteName}: ${s.home}`}>
          <img src="/logo.svg" width="183" height="45" alt="AltProtein Vietnam" />
          <span class="brand-label">{s.reportShort}</span>
        </a>
        <nav class="main-nav" aria-label={lang === 'vi' ? 'Điều hướng chính' : 'Main'}>
          {nav.map((item) => (
            <a href={item.href} aria-current={section === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-tools">
          <form class="search-form" role="search" action={searchAction} method="get">
            <label class="visually-hidden" for="q-top">
              {s.search}
            </label>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              id="q-top"
              name="q"
              type="search"
              placeholder={s.searchPlaceholder}
              autocomplete="off"
            />
          </form>
          <a
            class="lang-switch"
            href={otherHref}
            hreflang={lang === 'vi' ? 'en' : 'vi'}
            lang={lang === 'vi' ? 'en' : 'vi'}
            title={s.switchToLabel}
          >
            {lang === 'vi' ? 'EN' : 'VI'}
          </a>
          <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label={s.theme}>
            <svg
              class="i-sun"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg
              class="i-moon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg
              class="i-auto"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 3v18"></path>
              <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"></path>
            </svg>
          </button>
          <button
            class="icon-btn menu-btn"
            type="button"
            data-drawer-open
            aria-controls="drawer"
            aria-expanded="false"
            aria-label={s.menu}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label={s.menu}>
      <div class="drawer-backdrop" data-drawer-close></div>
      <div class="drawer-panel">
        <div class="drawer-head">
          <img src="/logo.svg" width="146" height="36" alt="" />
          <button class="icon-btn" type="button" data-drawer-close aria-label={s.close}>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>
        <form class="search-form" role="search" action={searchAction} method="get">
          <label class="visually-hidden" for="q-drawer">
            {s.search}
          </label>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input id="q-drawer" name="q" type="search" placeholder={s.searchPlaceholder} />
        </form>
        <div class="drawer-links">
          <a href={localize('/', lang)}>{s.home}</a>
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a href={localize('/glossary', lang)}>{s.glossaryHeading}</a>
          <a href={localize('/about', lang)}>{s.about}</a>
        </div>
        <NavTree lang={lang} current={current} />
      </div>
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <img src="/logo.svg" width="146" height="36" alt="AltProtein Vietnam" />
          <p>{s.footerLine}</p>
        </div>
        <div>
          <h2>{s.report}</h2>
          <ul>
            <li>
              <a href={localize('/summary', lang)}>
                {lang === 'vi' ? 'Tóm tắt (tiếng Anh)' : 'Executive summary'}
              </a>
            </li>
            <li>
              <a href={localize('/tom-tat', lang)} lang="vi">
                Tóm tắt tiếng Việt
              </a>
            </li>
            <li>
              <a href={localize('/at-a-glance', lang)}>
                {lang === 'vi' ? 'Tổng quan nhanh' : 'At a glance'}
              </a>
            </li>
            <li>
              <a href={localize('/report', lang)}>{s.report}</a>
            </li>
            <li>
              <a href={localize('/briefs', lang)}>{s.forYou}</a>
            </li>
            <li>
              <a href={localize('/appendices', lang)}>{s.appendices}</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>{s.data}</h2>
          <ul>
            <li>
              <a href={localize('/data', lang)}>{s.dataHeading}</a>
            </li>
            <li>
              <a href={localize('/glossary', lang)}>{s.glossaryHeading}</a>
            </li>
            <li>
              <a href={localize('/search', lang)}>{s.search}</a>
            </li>
            <li>
              <a href="/downloads/altprotein-vn-data.zip" download>
                {s.downloadData}
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h2>{s.about}</h2>
          <ul>
            <li>
              <a href={localize('/about', lang)}>{s.about}</a>
            </li>
            <li>
              <a href={localize('/how-to-read', lang)}>
                {lang === 'vi' ? 'Cách đọc báo cáo' : 'How to read this report'}
              </a>
            </li>
            <li>
              <a href={localize('/about', lang) + '#cite'}>{s.cite}</a>
            </li>
            <li>
              <a href="/_emdash/admin" rel="nofollow">
                {s.editorSignIn}
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="footer-base">
        <span>
          {SITE.publisher} ·{' '}
          {lang === 'vi' ? 'Ấn bản 1.1, tháng 9 năm 2026' : 'Edition 1.1, September 2026'}
        </span>
        <span>{s.notAdvice}</span>
      </div>
    </footer>
    <div class="tip" role="tooltip" id="tip" hidden></div>
    <EmDashBodyEnd page={page} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
