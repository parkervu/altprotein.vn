---
import Base from '../layouts/Base.astro';
import { getChapters, getReport, mayPreview } from '../lib/content';
import { parts, chapterHref, textOf, headingId } from '../lib/report.mjs';
if (Astro.url.searchParams.has('_preview') && !mayPreview(Astro.locals.user))
  return new Response('Editor sign-in is required for previews.', {
    status: 403,
    headers: { 'Cache-Control': 'private, no-store' },
  });
const [chapters, report] = await Promise.all([getChapters(), getReport()]);
if (!report)
  return new Response('The report is being prepared. Please check back shortly.', {
    status: 503,
    headers: { 'Cache-Control': 'no-store' },
  });
const chapter = (n: number) => chapters.find((c) => Number(c.data.number) === n);
const href = (n: number) => (chapter(n) ? chapterHref(chapter(n)) : '/#contents');
const ranking = chapter(5)?.data.content ?? [];
const ranked = ranking
  .filter((b) => /^h[2-6]$/.test(b.style ?? '') && /^\d\. /.test(textOf(b)))
  .map((block) => ({
    block,
    number: Number(textOf(block)[0]),
    title: textOf(block).replace(/^\d\. /, ''),
    description: textOf(ranking[ranking.indexOf(block) + 1]),
  }));
const revisionDate = report.data.revision_date;
---

<Base title={report.data.title} noindex={Astro.url.searchParams.has('_preview')}>
  <div class="dashboard">
    <div class="report-kicker">
      <span class="eyebrow">Vietnam / Novel protein / Scoping study</span>
      <span class="revision">
        {report.data.revision_label} <span>·</span>{' '}
        <time datetime={revisionDate}>
          {new Intl.DateTimeFormat('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          }).format(new Date(revisionDate))}
        </time>
      </span>
    </div>
    <section class="hero" aria-labelledby="report-title">
      <div>
        <h1 id="report-title">
          {report.data.title.split('Vietnam').map((piece, i) => (
            <>
              {i > 0 && <span>Vietnam</span>}
              {piece}
            </>
          ))}
        </h1>
        <p class="hero-subtitle">{report.data.subtitle}</p>
        <div class="hero-actions">
          <a class="button primary" href={href(4)}>
            Read the findings <span>↗</span>
          </a>
          <a class="text-link" href="#contents">
            Explore the full report <span>↓</span>
          </a>
        </div>
      </div>
      <aside class="research-note">
        <div class="note-top">
          <span class="eyebrow">The starting point</span>
          <span class="note-symbol" aria-hidden="true">
            ↗
          </span>
        </div>
        <p>
          A desk study,
          <br />
          not a business plan.
        </p>
        <span>
          What is known. What is not.
          <br />
          And the cheapest next step.
        </span>
        <a href={href(18)}>How the research was done →</a>
      </aside>
    </section>
    <div class="report-stats">
      <div>
        <strong>08</strong>
        <span>Parts of the study</span>
      </div>
      <div>
        <strong>19</strong>
        <span>Chapters, openly available</span>
      </div>
      <div>
        <strong>06</strong>
        <span>Ranked protein categories</span>
      </div>
      <a href={href(17)}>
        <strong>
          19 <span>↗</span>
        </strong>
        <span>Things worth doing next</span>
      </a>
    </div>
    <section class="ranking-section" aria-labelledby="ranking-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / The answer</p>
          <h2 id="ranking-title">Where Vietnam should start</h2>
        </div>
        <a class="text-link" href={href(5)}>
          Read the reasoning ↗
        </a>
      </div>
      <p class="section-intro">
        The report’s ranking, from the strongest fit to the categories to watch. A structured
        judgement of viability and fit for Vietnam.
      </p>
      <div class="rank-grid">
        {ranked.map((item) => (
          <a
            class:list={['rank-card', { 'rank-first': item.number === 1 }]}
            href={`${href(5)}#${headingId(item.block)}`}
          >
            <div class="rank-top">
              <span class="rank-number">{String(item.number).padStart(2, '0')}</span>
              <span class="rank-arrow" aria-hidden="true">
                ↗
              </span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="rank-bottom">
              Read category assessment <span>→</span>
            </span>
          </a>
        ))}
      </div>
    </section>
    <section class="reading-paths" aria-labelledby="paths-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / Choose your depth</p>
          <h2 id="paths-title">One report. Three ways in.</h2>
        </div>
      </div>
      <div class="path-grid">
        <a href={href(4)}>
          <span class="eyebrow">The decision / Parts 2–3</span>
          <h3>
            I want the answer <span>↗</span>
          </h3>
          <p>The findings, the ranking, and the regulatory obstacle.</p>
        </a>
        <a href={href(8)}>
          <span class="eyebrow">The detail / Parts 4–5</span>
          <h3>
            Show me the evidence <span>↗</span>
          </h3>
          <p>Vietnam’s feedstocks and the case for each protein category.</p>
        </a>
        <a href={href(14)}>
          <span class="eyebrow">The scrutiny / Parts 6–8</span>
          <h3>
            How solid is this? <span>↗</span>
          </h3>
          <p>Tested claims, conflicting figures, open questions, and sources.</p>
        </a>
      </div>
    </section>
    <section id="contents" class="full-contents" aria-labelledby="contents-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / Complete study</p>
          <h2 id="contents-title">The report, chapter by chapter</h2>
        </div>
        <a class="text-link" href="/about">
          Revision notes ↗
        </a>
      </div>
      <div class="contents-grid">
        {parts.map((part, i) => (
          <section class="part-card">
            <h3>
              <span class="part-number">{String(i + 1).padStart(2, '0')}</span>
              {part}
            </h3>
            <ol>
              {chapters
                .filter((c) => Number(c.data.part) === i + 1)
                .map((c) => (
                  <li>
                    <a href={chapterHref(c)}>
                      <span>{String(c.data.number).padStart(2, '0')}</span>
                      {c.data.title}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
            </ol>
          </section>
        ))}
      </div>
    </section>
    <aside class="next-step">
      <div>
        <p class="eyebrow">From the desk to the field</p>
        <h2>
          Nineteen things worth doing.
          <br />
          Ranked by cost.
        </h2>
      </div>
      <a class="button primary" href={href(17)}>
        What would move this forward <span>↗</span>
      </a>
    </aside>
  </div>
</Base>
